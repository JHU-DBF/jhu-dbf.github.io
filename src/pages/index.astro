---
import Layout from '~/layouts/PageLayout.astro';

import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import BentoImages from '~/components/widgets/BentoImages.astro';

import homeHero from "~/assets/images/home-hero.png";
import imgDrawingFly from "~/assets/images/drawing_fly.png";
import imgFlyday2Group from "~/assets/images/flyday2_group.jpg";
import imgRunwayHD from "~/assets/images/runway_HD.jpg";
import imgCAD2025 from "~/assets/images/cad_2025.png";
import imgFlying2025 from "~/assets/images/flying_2025.png";
import imgComp2025 from "~/assets/images/comp_2025.png";
import Button from '~/components/ui/Button.astro';
import { getPermalink } from '~/utils/permalinks';
import ModelViewer from '~/components/widgets/ModelViewer';

const metadata = {
  title: 'Design Build Fly @ JHU',
  ignoreTitleTemplate: true,
};

---

<Layout metadata={metadata}>
  <section class="relative md:-mt-[76px] not-prose">
    <div class="relative min-h-screen flex items-start justify-center overflow-hidden">
      <img
        src={homeHero.src}
        alt="Johns Hopkins Design Build Fly team with their RC plane"
        class="absolute inset-0 h-full w-full object-cover object-[center_18%] opacity-55"
        loading="eager"
      />
      <div class="absolute inset-0 bg-white/50 dark:bg-slate-950/35"></div>
      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 pt-28 md:pt-32 text-center">
        <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200">
          <span class="text-black dark:text-white">We are</span>
          <span class="text-accent dark:text-white highlight">Design Build Fly</span>
          - RC plane building team at Johns Hopkins University
        </h1>
        <p class="max-w-3xl mx-auto text-xl text-muted mb-6 dark:text-slate-300">
          Diversity &amp; Perfection
        </p>
      </div>
    </div>
  </section>
  <Steps
    isReversed
    title="Discover what we do!"
    subtitle="Step into any aspect of plane production that interests you"
    items={[
      {
        title: 'Design',
        description:
          'Each year, new constraints are required for our plane, giving us ample opportunity to come up with creative solutions. \
          Our team utilizes CAD and other software to optimize our plane!',
        icon: 'tabler:ruler',
      },
      {
        title: 'Build',
        description:
          'With access to the entirety of the Mechanical Engineering department\'s tools, we piece together our plane to turn it form \
          dream to reality.',
        icon: 'tabler:hammer',
      },
      {
        title: 'Fly',
        description:
          'Finally, we put our plane to the test! It may be more apt to call this step \'Crash,\' but each crashed prototype is experience \
          for both our flyers and designers to utilize for the next prototype.',
        icon: 'tabler:plane-tilt',
      },
    ]}
    image={{
      src: '~/assets/images/verticalDBF.jpg',
      alt: '2024 competition flight',
    }}
  />

  <ModelViewer client:load
    name="RC Plane Model 2026 - Peaking Jay!"
    filepath="/assets/models/PlaneFull26.glb"
    toggleableParts={[
      {
        id: 'fuselage',
        displayName: 'Fuselage',
        meshNames: ['Fuselage', 'fuselage']
      }
    ]}
    angle={100}
  />

  <!-- Stats Widget ****************** -->

  <Stats
  stats={[
      { icon: 'tabler:users', title: 'Members', amount: '15' },
      { icon: 'tabler:school', title: 'Alumni', amount: '26' },
      { icon: 'tabler:brand-instagram', title: 'Followers', amount: '253' },
      { icon: 'tabler:currency-dollar', title: 'Funding', amount: '$8,000' },
    ]}
  />

  <!-- Bento Box Images -->
  <BentoImages
    templateAreas={"[grid-template-areas:'img1_img1_img1_img1''img3_img3_img2_img2''img6_img5_img5_img4']"}
    images={
      [
        {
          src: imgFlying2025,
          alt: "flight banking",
          area:"[grid-area:img1]"
        },
        {
          src: imgRunwayHD,
          alt: "about to fly at competition",
          area:"[grid-area:img3]"
        },
        {
          src: imgComp2025,
          alt: "getting ready for ground mission",
          area:"[grid-area:img2]"
        },
        {
          src: imgDrawingFly,
          alt: "CAD drawing in flight configuration",
          area:"[grid-area:img4]"
        },
        {
          src: imgCAD2025,
          alt: "in-editor CAD screenshot",
          area:"[grid-area:img5]"
        },
        {
          src: imgFlyday2Group,
          alt: "group photo during a fly day",
          area:"[grid-area:img6]"
        },
      ]
    }
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
    <Fragment slot="below">
      <Button
        text="See more images"
        variant="primary"
        href={getPermalink("/about")}
        class="flex justify-self-center self-center"
      />
    </Fragment>
  </BentoImages>

  <!-- Add info on meeting times/location -->
  <Features3
    title="Let's Connect!"
    columns={3}
    items={[
      {
        title: "Email us at dbf@jhu.edu",
        description: "We'll get back to you as soon as possible!",
        icon: "tabler:mail",
      },
      {
        title: "Join us for a meeting",
        description: "3100 Wyman Park Dr\nBaltimore, MD 21211",
        icon: "tabler:map-pin",
      },
      {
        title: "Follow us on Instagram @jhu_dbf",
        description: "Stay up-to-date on upcoming events",
        icon: "tabler:brand-instagram",
      },
    ]}
  >
  </Features3>

  <!-- <Brands
    title="A special thanks to our sponsors"
    images={[
      {
        src: "https://www.lockheedmartin.com/content/dam/lockheed-martin/general/lm-logo.svg",
        alt: "placeholder logo",
      },
      {
        src: "https://www.lockheedmartin.com/content/dam/lockheed-martin/general/lm-logo.svg",
        alt: "placeholder logo",
      },
      {
        src: "https://www.lockheedmartin.com/content/dam/lockheed-martin/general/lm-logo.svg",
        alt: "placeholder logo",
      },
    ]}
  >  
  </Brands> -->
</Layout>
