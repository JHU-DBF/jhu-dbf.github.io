---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import ModelViewer from '~/components/widgets/ModelViewer';

// Import images
import planeFlightImg from '~/assets/images/2026/2026_Plane_Flight.webp';
import wetlayupImg from '~/assets/images/2026/wetlayup.jpg';
import scaleDownLayupImg from '~/assets/images/2026/scale_down_layup.jpg';
import vacuumBaggingImg from '~/assets/images/2026/vacuum_bagging.jpg';
import cncRouterImg from '~/assets/images/2026/cnc_router.jpg';
import wingFeaImg from '~/assets/images/2026/wing fea.png';
import cncHotWireCutterImg from '~/assets/images/2026/CNC_hot_wire_cutter.jpg';
import gcodeGenImg from '~/assets/images/2026/gcode_gen.jpeg';
import cfFuselagePrototypeImg from '~/assets/images/2026/cf_fuselage_prototype.jpg';
import plane2024Img from '~/assets/images/parked.jpg';
import plane2025Img from '~/assets/images/2026/plane_2025.jpg';
import planeLandingImg from '~/assets/images/2026/Plane_Landing.JPG';
import fuselageWithBoltsImg from '~/assets/images/2026/Fuselage_with_bolts.png';
import wingSparImg from '~/assets/images/2026/Wing_spar.webp';
import tailConnectorImg from '~/assets/images/2026/Tail_connector.webp';
import tailInstalledImg from '~/assets/images/2026/Tail_installed.webp';
import joinWingsImg from '~/assets/images/2026/Join_Wings.png';
import laidFuselage1Img from '~/assets/images/2026/Laid_Fuselage_1.png';
import laidFuselage2Img from '~/assets/images/2026/Laid_Fuselage_2.png';
import duckBurgersImg from '~/assets/images/2026/Duck_Burgers.png';
import hockeyPucksImg from '~/assets/images/2026/Hockey_Pucks.png';
import pinSlideCadImg from '~/assets/images/2026/Pin_Slide_CAD.png';
import pinSlidePrintImg from '~/assets/images/2026/Pin_Slide_Print.png';
import bannerInPlaceImg from '~/assets/images/2026/Banner_In_Place.png';
import bannerFlyingImg from '~/assets/images/2026/Banner_Flying.png';

const metadata = {
  title: 'Competition 2026',
};
---

<Layout metadata={metadata}>
  <Hero
    image={{ src: planeFlightImg, alt: 'Peaking Jay in flight at competition', width: 2048, height: 1365 }}
  >
    <Fragment slot="title">
      <div class="text-sm text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-1">Competition 2026</div>
      Peaking Jay
    </Fragment>
    <Fragment slot="subtitle">
      A fully carbon fiber design: The ultimate competitive edge
    </Fragment>

    <Fragment slot="caption">
      Credit to Missouri S&amp;T/Bob Phelan at phelanb@mst.edu
    </Fragment>
  </Hero>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-wrap justify-center -m-4 text-center">
      <div class="p-4 md:w-1/3 sm:w-1/2 w-full min-w-[220px] text-center md:border-r dark:md:border-slate-500">
        <div class="flex items-center justify-center mx-auto mb-3 text-primary">
          <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <div class="font-heading text-primary text-2xl font-bold dark:text-white lg:text-3xl">14.5 lbs</div>
        <div class="text-xs font-medium uppercase tracking-widest text-gray-800 dark:text-slate-400 lg:text-sm">Aircraft Weight</div>
      </div>
      <div class="p-4 md:w-1/3 sm:w-1/2 w-full min-w-[220px] text-center md:border-r dark:md:border-slate-500">
        <div class="flex items-center justify-center mx-auto mb-3 text-primary">
          <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 4l9 5.5"></path><path d="m12 4 0 16"></path><path d="M5 11v6.5a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V11"></path><path d="M15 11v6.5a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V11"></path></svg>
        </div>
        <div class="font-heading text-primary text-2xl font-bold dark:text-white lg:text-3xl">65 mph</div>
        <div class="text-xs font-medium uppercase tracking-widest text-gray-800 dark:text-slate-400 lg:text-sm">Top Speed</div>
      </div>
      <div class="p-4 md:w-1/3 sm:w-1/2 w-full min-w-[220px] text-center">
        <div class="flex items-center justify-center mx-auto mb-3 text-primary">
          <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
        </div>
        <div class="font-heading text-primary text-2xl font-bold dark:text-white lg:text-3xl">17th of 175</div>
        <div class="text-xs font-medium uppercase tracking-widest text-gray-800 dark:text-slate-400 lg:text-sm">2026 Placement</div>
      </div>
    </div>
  </div>

  <ModelViewer client:load
    name="RC Plane Model 2026 - Peaking Jay!"
    filepath="/assets/models/PlaneFull26.glb"
    angle={100}
    toggleableParts={[
      {
        id: 'fuselage',
        displayName: 'Fuselage',
        meshNames: ['Fuselage', 'fuselage']
      }
    ]}
  />

  <div class="flex justify-between flex-col max-w-5xl mx-auto mt-0 mb-2 px-4 sm:px-6">
    <div class="mx-auto sm:px-6 max-w-5xl px-6 mt-8 dark:prose-a:text-blue-400 dark:prose-headings:text-slate-300 dark:prose-invert lg:prose-xl prose prose-a:text-primary prose-headings:font-bold prose-headings:font-heading prose-headings:leading-tighter prose-headings:scroll-mt-[80px] prose-headings:tracking-tighter prose-img:rounded-md prose-img:shadow-lg prose-li:my-0 prose-md">
      
      <h2 class="text-center">The ultimate competitive edge</h2>
      
      <p class="text-justify">
        In just two years, our team has made tremendous progress. We started small with a foamboard aircraft that weighed only 4 lb, and other teams nicknamed it "the cardboard plane." Despite its simplicity, limited payload, and budget nearly 5–20 times smaller than most teams, we managed to place in the top half of the competition.
      </p>

      <p class="text-justify">
        Motivated by this success, we aimed higher the following year. We designed and built a 6 ft wingspan wooden aircraft weighing 7 lbs, a major step forward in complexity and ambition. Despite the setbacks when the plane crashed on the first day due to the Arizona heat, we persevered and completed two of the three missions, ultimately finishing in the top third overall.
      </p>

      <p class="text-justify">
        Now, we aimed even higher. Our team took on the challenge of building a fully carbon composite aircraft — a leap that places us among top-performing teams with decades of experience, much larger memberships, and budgets several times our own. With this effort, we set our goal to finish in the top 20 teams, and worked really hard to finally make it happen!

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
        <div class="flex flex-col items-center">
          <Image
            src={plane2024Img}
            alt="2024 Competition Aircraft"
            class="rounded-lg shadow-lg w-full object-cover h-64"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">2024 - The Phoenix</p>
        </div>
        <div class="flex flex-col items-center">
          <Image
            src={plane2025Img}
            alt="2025 Competition Aircraft"
            class="rounded-lg shadow-lg w-full object-cover h-64"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">2025 - The Freedom Fighter</p>
        </div>
      </div>

      <h2 class="text-center mt-12">Design Specifications</h2>

      <p class="text-justify">
        The plane had weighed 14.5 lbs with a top speed of 65 mph. It can carry a large payload in its large carbon fiber fuselage. Additionally, it can tow a large banner (2 x 10 ft) for 5 minutes.
      </p>

      <h2 class="text-center mt-12">Manufacturing Process Validation</h2>

      <p class="text-justify">
        A scaled-down fuselage half was built to validate the manufacturing process and test structural integrity. We set up VCarve to CNC mill two female mold halves out of XPS foam. We then treated them with an epoxy coating to smooth out the surface and applied multiple layers of PVA as mold release agents. We performed a three-layer layup of bidirectional carbon fiber cloth in a 0/90°, ±45°, 0/90° orientation.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <div class="flex flex-col items-center">
          <Image
            src={scaleDownLayupImg}
            alt="Scaled-down prototype"
            class="rounded-lg shadow-lg w-full object-cover h-80"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Scaled-down prototype</p>
        </div>
        <div class="flex flex-col items-center">
          <Image
            src={cncRouterImg}
            alt="CNC router in operation"
            class="rounded-lg shadow-lg w-full object-cover h-80"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">CNC milling the female mold halves</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <div class="flex flex-col items-center">
          <Image
            src={wetlayupImg}
            alt="Wet layup process"
            class="rounded-lg shadow-lg w-full object-cover h-80"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Wet layup process</p>
        </div>
        <div class="flex flex-col items-center">
          <Image
            src={vacuumBaggingImg}
            alt="Vacuum bagging"
            class="rounded-lg shadow-lg w-full object-cover h-80"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Vacuum bagging technique</p>
        </div>
      </div>

      <h2 class="text-center mt-12">Structural Analysis</h2>

      <p class="text-justify">
        To validate the wing's structural design, we performed a Finite Element Analysis (FEA) in Abaqus. The model simulated an assembly of an XPS foam core insert, an internal carbon fiber spar, and a skin made from wet layup of two layers of ±45° bidirectional carbon fiber. A distributed lift force (scaled to simulate a 6G maneuver) calculated from aerodynamic parameters, was applied to the cantilevered wing structure. The results confirmed the design's integrity, showing minimal deflection and stress levels safely below material failure points.
      </p>

      <div class="flex flex-col items-center my-6">
        <Image
          src={wingFeaImg}
          alt="FEA simulation results"
          class="rounded-lg shadow-lg w-full max-w-4xl"
        />
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 italic">
          Finite Element Analysis showing stress distribution under 6G load
        </p>
      </div>

      <h2 class="text-center mt-12">Custom Manufacturing Tools</h2>

      <p class="text-justify">
        The wing is made out of carbon fiber wrapped XPS foam which is hot wire cut using our own custom CNC hot wire cutter. We even developed our own custom g-code generator as there is no open source software which satisfies our need that currently exists.
      </p>

      <p class="text-justify">
        Using our custom-built CNC hot wire cutter controlled by in-house developed g-code generation software, we built our wing into highly specific airfoil shapes from XPS foam. We then wrapped the shaped foam with carbon fiber to achieve our rigorous structural requirements. Our specialized tools give us an advantage in manufacturing capacity and quality, as no existing tooling has been available for our needs until now.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <div class="flex flex-col items-center">
          <Image
            src={cncHotWireCutterImg}
            alt="Custom CNC hot wire cutter"
            class="rounded-lg shadow-lg w-full object-cover h-80"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Our custom-built CNC hot wire cutter</p>
        </div>
        <div class="flex flex-col items-center">
          <Image
            src={gcodeGenImg}
            alt="G-code generation software"
            class="rounded-lg shadow-lg w-full object-cover h-80"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">In-house developed g-code generator</p>
        </div>
      </div>

      <div class="flex flex-col items-center my-6">
        <Image
          src={cfFuselagePrototypeImg}
          alt="Carbon fiber fuselage prototype"
          class="rounded-lg shadow-lg w-full max-w-3xl"
        />
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 italic">
          Final carbon fiber fuselage prototype
        </p>
      </div>

      <h2 class="text-center mt-12">Putting all the main components together</h2>

      <p class="text-justify">
        Our final plane is a scaled up version of our prototypes. We laid up two halves of the fuselage with carbon fiber and decided to join them together using M3 bolts and nuts.
      </p>

      <div class="flex flex-col items-center my-6">
        <!-- Sized by height, not width: these two differ sharply in aspect ratio
             (3:4 vs. roughly 1:4), so equal columns would blow the skinny one up. -->
        <div class="flex justify-center items-end gap-4 w-full">
          <Image
            src={laidFuselage1Img}
            alt="Final laid-up carbon fiber fuselage"
            class="rounded-lg shadow-lg h-72 sm:h-96 w-auto max-w-full"
          />
          <Image
            src={laidFuselage2Img}
            alt="Final laid-up carbon fiber fuselage from another angle"
            class="rounded-lg shadow-lg h-72 sm:h-96 w-auto max-w-full"
          />
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Final laid-up carbon fiber fuselage</p>
      </div>

      <div class="flex flex-col items-center my-6">
        <Image
          src={fuselageWithBoltsImg}
          alt="Fuselage halves joined with M3 bolts and nuts"
          class="rounded-lg shadow-lg w-full max-w-[33.6rem] h-auto"
        />
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Fuselage halves bolted together with M3 hardware</p>
      </div>

      <p class="text-justify">
        This year's second mission involved flying the plane with a payload of duck and hockey puck passengers. We installed these passengers using &ldquo;Duck Burgers&rdquo; and hockey puck trays. The burgers slid in through the two holes on the top of the fuselage and the trays were inserted at the very front of the plane, directly under the propeller.
      </p>

      <div class="flex flex-col items-center my-6">
        <Image
          src={duckBurgersImg}
          alt="The Duck Burgers used to secure the ducks inside the plane"
          class="rounded-lg shadow-lg w-full max-w-[26.2rem] h-auto"
        />
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">The iconic &ldquo;Duck Burgers&rdquo; that secured the ducks inside the plane</p>
      </div>

      <div class="flex flex-col items-center my-6">
        <Image
          src={wingSparImg}
          alt="Cuts on the fuselage for payload entry"
          class="rounded-lg shadow-lg w-full max-w-[26.2rem] h-auto"
        />
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Cuts on the fuselage for payload entry</p>
      </div>

      <div class="flex flex-col items-center my-6">
        <Image
          src={hockeyPucksImg}
          alt="Hockey puck tray designed to fit under the burgers"
          class="rounded-lg shadow-lg w-full max-w-[33.6rem] h-auto"
        />
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Our hockey puck tray designed to fit under the burgers</p>
      </div>

      <p class="text-justify">
        The two laid-up foam wings were joined together using the middle carbon fiber spar: the spar stays fixed inside the fuselage at the approximate location that balances the center of gravity, so that the wings can be removed and re-inserted at any time.
      </p>

      <div class="flex flex-col items-center my-6">
        <Image
          src={joinWingsImg}
          alt="Central carbon fiber wing spar fixed inside the fuselage"
          class="rounded-lg shadow-lg w-full max-w-3xl"
        />
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 italic">
          The central carbon fiber spar that joins the wings
        </p>
      </div>

      <p class="text-justify">
        The tail is ultimately joined with a laser-cut prism that locks both the horizontal and vertical stabilizers in place.
      </p>

      <div class="grid grid-cols-2 gap-4 my-6 w-full max-w-[33.6rem] mx-auto items-end">
        <div class="flex flex-col items-center">
          <Image
            src={tailConnectorImg}
            alt="Laser-cut prism tail connector"
            class="rounded-lg shadow-lg w-full h-auto"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Laser-cut prism tail connector</p>
        </div>
        <div class="flex flex-col items-center">
          <Image
            src={tailInstalledImg}
            alt="Tail installed with stabilizers locked in place"
            class="rounded-lg shadow-lg w-full h-auto"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Tail installed with both stabilizers locked in</p>
        </div>
      </div>

      <p class="text-justify">
        This year featured a final mission that required us to drop a banner behind our plane, fly it for several minutes, and release it so that it reaches the ground. In order to execute a smooth deployment of the banner, we created a sliding pin mechanism staged inside the plane that controlled the unfurling of zip-tie bands around the banner.
      </p>

      <div class="flex flex-col items-center my-6">
        <div class="grid grid-cols-2 gap-4 w-full max-w-[47.04rem] items-end">
          <Image
            src={pinSlideCadImg}
            alt="CAD model of the pin-sliding banner release mechanism"
            class="rounded-lg shadow-lg w-full h-auto"
          />
          <Image
            src={pinSlidePrintImg}
            alt="3D printed pin-sliding banner release mechanism"
            class="rounded-lg shadow-lg w-full h-auto"
          />
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">Pin-Sliding Mechanism - 3D Print and CAD</p>
      </div>

      <div class="flex flex-col items-center my-6">
        <div class="grid grid-cols-2 gap-4 w-full items-center">
          <Image
            src={bannerInPlaceImg}
            alt="Banner staged in place before deployment"
            class="rounded-lg shadow-lg w-full h-auto"
          />
          <Image
            src={bannerFlyingImg}
            alt="Banner deployed and flying behind the aircraft"
            class="rounded-lg shadow-lg w-full h-auto"
          />
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 text-center">A successful release of the banner, solidifying our top 20 spot</p>
      </div>

      <div class="bg-blue-50 dark:bg-blue-900/20 p-8 rounded-lg my-12 text-center">
        <h3 class="text-2xl font-bold mb-4">Our 2026 Goal</h3>
        <p class="text-xl font-semibold text-blue-
         dark:text-blue-400">
          Finish in the Top 20 Teams
        </p>
        <p class="mt-4 text-justify">
          With our fully carbon composite aircraft and innovative manufacturing techniques, we competed with the best teams in the nation and finished in the Top 20 of 175 teams, achieving a lifelong goal for our club! From here, it will only be up: next stop, Top 10!
        </p>

        <div class="flex flex-col items-center mt-8">
          <Image
            src={planeLandingImg}
            alt="Peaking Jay coming in for a landing at competition"
            class="rounded-lg shadow-lg w-full max-w-3xl"
          />
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5 italic">
            Peaking Jay coming in for a landing
          </p>
        </div>
      </div>

    </div>
  </div>
</Layout>