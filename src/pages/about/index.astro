---
import Layout from '~/layouts/PageLayout.astro';

import HeroText from '~/components/widgets/HeroText.astro';
import { Image } from 'astro:assets';

import imgBrainstorm from './Brainstorm.webp';
import imgCAD from './CAD.png';
import imgCFD from './CFD.png';
import imgFEA from './FEA.png';
import imgLaserCuts from './Laser-Cuts.webp';
import img3dPrints from './3D_Prints.webp';
import imgWingFoam from './Wing_Foam.webp';
import imgTailFoam from './Tail_Foam.webp';
import imgFuselageFoam from './Fuselage_Foam.webp';
import imgCFLayup from './CF_Layup.webp';
import imgVacuumBag from './Vacuum_Bag.webp';
import imgElectronics from './Electronics.webp';
import imgSoldering from './Soldering.webp';
import imgWingTest from './WingTest.png';
import imgVertStabTest from './VertStabTest.png';
import imgAssembling from './Assembling.jpg';
import imgAssembling2 from './Assembling2.jpg';
import imgAssembling3 from './Assembling3.jpg';
import imgFlyoff from './Flyoff.png';

const metadata = {
  title: 'What We Do',
  ignoreTitleTemplate: true,
};

const steps = [
  {
    phase: 'Design',
    title: 'Brainstorm ideas based on the competition rules',
    images: [
      { src: imgBrainstorm, alt: 'Whiteboard sketch of the aircraft top and side views with labeled compartments' },
    ],
  },
  {
    phase: 'Design',
    title: 'Create the CAD model of the plane and its subcomponents',
    images: [
      { src: imgCAD, alt: 'SolidWorks main assembly of the carbon fiber aircraft' },
    ],
  },
  {
    phase: 'Design',
    title: 'Conduct flight analytics',
    images: [
      { src: imgCFD, alt: 'CFD velocity contour comparison of landing gear fairing shapes', contain: true },
      { src: imgFEA, alt: 'Hard-landing FEA equivalent-stress (von-Mises) result on the airframe', contain: true },
    ],
  },
  {
    phase: 'Manufacturing',
    title: 'Laser-cut and 3D-print parts for rapid design iteration',
    images: [
      { src: imgLaserCuts, alt: 'Laser-cut plywood ribs and fuselage formers' },
      { src: img3dPrints, alt: '3D-printed mounts and aerodynamic fairings' },
    ],
  },
  {
    phase: 'Manufacturing',
    title: 'Shape the wing, tail, and fuselage with XPS foam',
    images: [
      { src: imgWingFoam, alt: 'XPS foam wing and tail sections cut to shape' },
      { src: imgTailFoam, alt: 'Team member holding a shaped foam tail' },
      { src: imgFuselageFoam, alt: 'Foam mold for the fuselage' },
    ],
  },
  {
    phase: 'Manufacturing',
    title: 'Apply carbon fiber layup to the foam and vacuum bag',
    images: [
      { src: imgCFLayup, alt: 'Team applying carbon fiber layup over the foam core' },
      { src: imgVacuumBag, alt: 'Carbon fiber parts curing under a vacuum bag' },
    ],
  },
  {
    phase: 'Manufacturing',
    title: 'Implement plane electronics',
    images: [
      { src: imgElectronics, alt: 'Wiring and soldering the receiver, ESC, and transmitter connections' },
      { src: imgSoldering, alt: 'Soldering electronic connections for the aircraft' },
    ],
  },
  {
    phase: 'Manufacturing',
    title: 'Test manufactured parts',
    images: [
      { src: imgWingTest, alt: 'Wing loading test with weight suspended from the center section' },
      { src: imgVertStabTest, alt: 'Vertical stabilizer loading test on a carbon fiber panel' },
    ],
  },
  {
    phase: 'Manufacturing',
    title: 'Assemble the plane',
    images: [
      { src: imgAssembling, alt: 'Team assembling the aircraft components' },
      { src: imgAssembling2, alt: 'Team with the finished carbon fiber airframe' },
      { src: imgAssembling3, alt: 'The completed aircraft at the competition' },
    ],
  },
  {
    phase: 'Competition',
    title: 'Fly-Off!',
    images: [{ src: imgFlyoff, alt: 'The aircraft in flight towing its competition banner' }],
  },
];
---

<Layout metadata={metadata}>
  <HeroText>
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">Our Path to a Successful Flight</span>
    </Fragment>

    <Fragment slot="subtitle">
      From concept to competition — here's how we design, build, and fly our plane each year.
    </Fragment>
  </HeroText>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16 md:pb-24">
    <div class="space-y-16 md:space-y-24">
      {
        steps.map(({ phase, title, images }, index) => {
          const showPhase = index === 0 || steps[index - 1].phase !== phase;
          return (
            <div class="wwd-reveal text-center">
              {showPhase && (
                <p class="text-sm font-bold tracking-widest uppercase text-accent mb-3">{phase}</p>
              )}
              <h2 class="text-3xl md:text-4xl font-bold font-heading text-accent dark:text-white highlight mb-8">
                {title}
              </h2>
              {images.length > 0 && (
                <div
                  class={`grid gap-4 sm:gap-6 ${
                    images.length === 1
                      ? 'max-w-2xl mx-auto'
                      : images.length === 2
                        ? 'sm:grid-cols-2 max-w-4xl mx-auto'
                        : 'sm:grid-cols-2 lg:grid-cols-3'
                  }`}
                >
                  {images.map((img) => (
                    <Image
                      src={img.src}
                      alt={img.alt}
                      class={`w-full h-64 sm:h-72 rounded-2xl shadow-lg ${
                        img.contain
                          ? 'object-contain bg-slate-100 dark:bg-slate-900 p-2'
                          : 'object-cover'
                      }`}
                      widths={[400, 768, 1024]}
                      sizes="(max-width: 640px) 100vw, 33vw"
                    />
                  ))}
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const items = document.querySelectorAll('.wwd-reveal');

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((item) => item.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.15 }
      );

      items.forEach((item) => observer.observe(item));
    });
  </script>

  <style>
    .wwd-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 650ms ease,
        transform 650ms ease;
    }

    .wwd-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</Layout>