---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero_sponsor from '~/components/widgets/Hero_sponsor.astro';
import Layout from '~/layouts/PageLayout.astro';
import FundraiseThermometer from '~/components/widgets/FundraiseThermometer.astro';

import Brands from '~/components/widgets/Brands.astro';

import Airtech from '~/assets/images/logos/Airtech.png';
import APC from '~/assets/images/logos/APC Propellers.png';
import Dragon from '~/assets/images/logos/Dragon Plate.png';
import HiTec from '~/assets/images/logos/HiTec.png';
import Reliable from '~/assets/images/logos/Reliable Robotics.png';
import Scorpion from '~/assets/images/logos/Scorpion Power Systems.png';
import Venom from '~/assets/images/logos/Venom Carbon.png';
import Formlabs from '~/assets/images/logos/Formlabs.png';
import PCBWay from '~/assets/images/logos/pcbway.webp';


const metadata = {
  title: 'Sponsorship & Contact',
};
---

<Layout metadata={metadata}>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-12 md:pt-16 pb-4 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-black dark:text-white">
      Sponsorship &amp; Contact
    </h1>
    <p class="max-w-3xl mx-auto mt-8 text-lg md:text-xl text-gray-500 dark:text-gray-300">
      The support of our sponsors play a vital role in making our work possible. To learn more about supporting JHU DBF, please check out the information below!
    </p>
  </section>

  <Brands
  title="Special thanks to our current sponsors!"
  images={[
    { src: Reliable, alt: "Reliable Robotics", href: "https://reliable.co/", tier: "platinum" },
    { src: Dragon, alt: "Dragon Plate", href: "https://dragonplate.com/", tier: "platinum" },
    { src: HiTec, alt: "HiTec", href: "https://hitecrcd.com/", tier: "platinum" },
    { src: Airtech, alt: "Airtech", href: "https://airtech.com/", tier: "platinum" },

    { src: APC, alt: "APC Propellers", href: "https://www.apcprop.com", tier: "gold" },
    { src: Scorpion, alt: "Scorpion Power", href: "https://www.scorpionsystem.com/", tier: "gold" },
    { src: Venom, alt: "Venom Carbon", href: "https://www.venomcarbon.com/", tier: "gold" },
    { src: Formlabs, alt: "Formlabs", href: "https://formlabs.com/", tier: "gold" },

    { src: PCBWay, alt: "PCB Way", href: "https://www.pcbway.com/", tier: "silver" },
  ]}
/>
  
  <Hero_sponsor
    actions={[
      {
        variant: 'primary',
        text: 'Download Sponsorship Information',
        href: '/assets/dbf_sponsorshipleaflet_25-26.pdf',
        target: '_blank',
        icon: 'tabler:download',
      }
    ]}>
    <Fragment slot="title">
      Sponsor Us!
    </Fragment>

    <Fragment slot="subtitle">
      Support can be in various forms including material and monetary donations. Our team relies entirely on the donations from individuals and organizations like yours to offer opportunities and experiences to the next generation of doers. If you're interested in supporting us, please check out the document below!
    </Fragment>
  </Hero_sponsor>

  <FundraiseThermometer />

  <Features3
    title="Contact Us!"
    columns={3}
    items={[
      {
        title: "Email us at dbf@jhu.edu",
        description: "We'll get back to you as soon as possible!",
        icon: "tabler:mail",
      },
      {
        title: "Join our Discord at discord.gg/E2aAKby9D8",
        description: "Check out what we do behind the scenes!",
        icon: "tabler:brand-discord",
      },
      {
        title: "Follow us on Instagram @jhu_dbf",
        description: "DM us with a question!",
        icon: "tabler:brand-instagram",
      },
    ]}
  >
  </Features3>

  <!-- <Features2
    title="Join a Weekly Meeting!"
    tagline=""
    columns={4}
    items={[
      {
        title: 'Tuesday 7-9pm',
        description: 'DBF lab / Makerspace',
      },
      {
        title: 'Thursday 7-9pm',
        description: 'DBF lab / Wind-tunnel lab / Makerspace',
      },
      {
        title: 'Saturday 11am-',
        description: 'DBF lab / Makerspace',
      },
      {
        title: 'Sunday 10am-',
        description: 'Fly day at local RC airfield',
      },
    ]}
  /> -->

</Layout>